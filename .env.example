# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
USE_POSTGRESQL=True
DB_NAME=pmc_db
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# CORS Settings (local). Production/Vercel: see block at bottom of this file.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
# Optional local override (comma-separated, no spaces required):
# CORS_ALLOWED_ORIGINS=https://planeteye-pmc-front.vercel.app,http://localhost:5178
# CSRF_TRUSTED_ORIGINS=https://planeteye-pmc-front.vercel.app,http://localhost:5178

# JWT Settings
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1

# CSRF Settings
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=False
CSRF_USE_SESSIONS=False

# Static and Media Files
STATIC_URL=static/
MEDIA_URL=/media/
MEDIA_ROOT=media

# Pagination
PAGE_SIZE=20

# Redis cache (Railway / local). If unset or unreachable, LocMem is used.
# REDIS_URL=redis://default:password@host:port
# REDIS_KEY_PREFIX=pmc
# CACHE_TTL_OVERVIEW=300
# CACHE_TTL_DROPDOWN=1800
# CACHE_TTL_DASHBOARD=300
# SCAN/delete_pattern on writes (default off; version bump is sufficient)
# CACHE_INVALIDATE_SCAN=false
# Cache health counters flush in the background (not on DPR write path)
# CACHE_METRICS_INLINE=false

# Celery — reuse REDIS_URL as broker for async DPR submission emails
# CELERY_BROKER_URL=redis://default:password@host:port
# CELERY_RESULT_BACKEND=redis://default:password@host:port
# CELERY_TASK_ALWAYS_EAGER=false
# Start worker: celery -A backend worker -l info
# CACHE_PREWARM_ON_STARTUP=false

# Celery — reuse REDIS_URL as broker for async DPR submission emails
# CELERY_BROKER_URL=redis://default:password@host:port
# CELERY_RESULT_BACKEND=redis://default:password@host:port
# CELERY_TASK_ALWAYS_EAGER=false
# Start worker: celery -A backend worker -l info

# Transactional email (Gmail SMTP for org registration notify)
# Never commit the real Gmail app password.
EMAIL_TRANSPORT=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
EMAIL_HOST_USER=planetedevm@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-16-char-app-password
DEFAULT_FROM_EMAIL=planetedevm@gmail.com
ORGANIZATION_REGISTRATION_NOTIFY_EMAIL=planetedevm@gmail.com
BREVO_FROM_EMAIL=planetedevm@gmail.com
BREVO_FROM_NAME=PlanetEye INFRA-AI
DPR_EMAIL_ENABLED=true
DPR_EMAIL_INLINE=false
# PMC Head / Head Office daily digest (15:30 IST via external scheduler).
DPR_DIGEST_ENABLED=true
# Required for POST /api/internal/dpr/executive-digest/ (X-CRON-SECRET header).
DPR_DIGEST_CRON_SECRET=change-me-to-a-long-random-secret
# Optional safe diagnostics (roles/counts only — never addresses).
# DPR_DIGEST_DIAGNOSTIC=false
DPR_TEST_EMAIL=planetedevm@gmail.com
# Public HTTPS logo (recommended). CID attachments often fail in Outlook.
# EMAIL_LOGO_URL=https://your-bucket.s3.region.amazonaws.com/email/scl_logo.png
# Production: DPR_EMAIL_INLINE=false (email after commit on a thread pool)
# Tests set INLINE=true so jobs run without real threads.
# DPR_EMAIL_MAX_WORKERS=4
# DPR_EMAIL_MAX_PENDING=200
# DPR_EMAIL_SLOW_SEC=10
# DPR_PERF_LOG=true

# AWS S3 (Site Progress Images — primary storage)
# REQUIRED on Vercel for POST /api/organization-registrations/ (logo upload).
# Vercel disk is read-only; logos are stored in S3, not MEDIA_ROOT.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=pmcproject
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_UPLOAD_PREFIX=upload
# Optional S3 prefix for public organization registration logos
# ORGANIZATION_LOGOS_S3_PREFIX=organization-registrations
# Drawing register file attachments (S3 prefix under bucket)
# DRAWING_FILES_S3_PREFIX=Drawing
# DRAWING_MAX_FILE_SIZE=104857600
# DRAWING_ALLOWED_EXTENSIONS=.pdf,.dwg,.dxf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png
# SITE_IMAGE_STORAGE_PRIMARY=s3

# SITE_IMAGE_S3_ONLY=True

# Cloudinary (Site Progress Images — fallback when SITE_IMAGE_S3_ONLY=False)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Production / Railway|Render|Vercel (settings_prod) — REQUIRED or boot fails:
# DJANGO_SETTINGS_MODULE=backend.settings_prod
# SECRET_KEY=long-random-secret
# DATABASE_URL=postgresql://...
#
# --- Copy these into Vercel → Backend project → Environment Variables, then Redeploy ---
# ALLOWED_HOSTS=planeteye-pmc-back-4fa2.vercel.app
# CORS_ALLOWED_ORIGINS=https://planeteye-pmc-front.vercel.app,http://localhost:5178,http://localhost:5173,http://127.0.0.1:5178,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=https://planeteye-pmc-front.vercel.app,http://localhost:5178,http://localhost:5173,http://127.0.0.1:5178
# Do NOT set CORS_ALLOW_ALL_ORIGINS=True with credentials (browser rejects *).
# Code defaults also allow hosted FE + localhost:5173–5179 after this deploy.
#
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
# SECURE_SSL_REDIRECT=true
# ALLOW_RENDER_HOSTS=false
# Vercel: also set EMAIL_* / ORGANIZATION_REGISTRATION_NOTIFY_EMAIL and AWS_* above.
# After deploy: run `python manage.py migrate` against the production DATABASE_URL
# so organization_registrations tables exist.
