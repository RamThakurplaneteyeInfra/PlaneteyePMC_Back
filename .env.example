# Django Settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
USE_POSTGRESQL=True
DB_NAME=pmc_db
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# JWT Settings
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1

# CSRF Settings
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=False
CSRF_USE_SESSIONS=False

# Static and Media Files
STATIC_URL=static/
MEDIA_URL=/media/
MEDIA_ROOT=media

# Pagination
PAGE_SIZE=20

# Redis cache (Railway / local). If unset or unreachable, LocMem is used.
# REDIS_URL=redis://default:password@host:port
# REDIS_KEY_PREFIX=pmc
# CACHE_TTL_OVERVIEW=300
# CACHE_TTL_DROPDOWN=1800
# CACHE_TTL_DASHBOARD=300
# CACHE_PREWARM_ON_STARTUP=false

# AWS S3 (Site Progress Images — primary storage)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=pmcproject
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_UPLOAD_PREFIX=upload
# SITE_IMAGE_STORAGE_PRIMARY=s3

# SITE_IMAGE_S3_ONLY=True

# Cloudinary (Site Progress Images — fallback when SITE_IMAGE_S3_ONLY=False)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Production / Render (settings_prod)
# SECRET_KEY=long-random-secret
# DATABASE_URL=postgresql://...
# ALLOWED_HOSTS=your-service.onrender.com
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com
